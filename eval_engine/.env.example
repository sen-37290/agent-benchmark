# Copy this file to `.env` and fill in the values. Never commit `.env`.

# SSH target accepted by the local `ssh` command: an alias or `user@host`.
# SSH credentials remain in ~/.ssh or an SSH agent; never put a private key in this file.
AGENT_BENCH_SSH_HOST=agent-benchmark-vm

# Required for GLM-5.2 and Kimi-K3 requests through OpenRouter.
OPENROUTER_API_KEY=

# NOTE: Friendli BYOK uses the Friendli key registered in the OpenRouter dashboard.
# A FRIENDLI_API_KEY value sent with an inference request would be ignored.

# Required for Opus 5 requests sent directly to Anthropic.
ANTHROPIC_API_KEY=
